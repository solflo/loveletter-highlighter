{
  "name": "loveletter",
  "displayName": "love letter language",
  "description": "custom highlighting for love letter text files",
  "publisher": "solflo",
  "version": "1.1.0",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [{
      "id": "loveletter",
      "aliases": ["love letter", "loveletter"],
      "extensions": [".letter",".txt"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "loveletter",
      "scopeName": "source.txt.loveletter",
      "path": "./syntaxes/loveletter.tmLanguage.json"
    }]
  }
}
